# Pirates of Ybor settings. © 2026 Adam Kornreich / R.A. Consulting ❤ Pops & Pippy
# Copy this file to .env for local builds. .env is never committed.
# In Codemagic, put the POY_ values in the environment group "poy_public".
# The SECRET values at the bottom go ONLY into Supabase (Dashboard → Edge Functions → Secrets),
# never into this repo, the app, or chat.

# ───────── Public (safe to ship inside the app and website) ─────────
# cloud = normal (default). local = test mode: no sign-in, a fixed local player, everything stays on the
# device, store items unlock free. Only works at localhost or in a developer app build; ignored at
# thepiratesofybor.com, and the build refuses it on Codemagic.
POY_APP_MODE=cloud
# Supabase → Project Settings → API → Project URL
POY_SUPABASE_URL=
# Supabase → Project Settings → API → "anon public" key (protected by row level security)
POY_SUPABASE_ANON_KEY=
# RevenueCat → Project → API keys → the PUBLIC app-specific key for each store (starts appl_, goog_, amzn_)
POY_REVENUECAT_APPLE_KEY=
POY_REVENUECAT_GOOGLE_KEY=
POY_REVENUECAT_AMAZON_KEY=
# Which Android store this build is for: google, amazon or samsung (samsung = purchases off)
POY_ANDROID_STORE=google
# The Services ID you create for Sign in with Apple on the website (Apple Developer → Identifiers → Services IDs)
POY_APPLE_SERVICE_ID=com.raconsulting.piratesofybor.signin
# Store page links, once each store approves the app (the website shows "Coming soon" until set)
POY_LINK_APP_STORE=
POY_LINK_GOOGLE_PLAY=
POY_LINK_AMAZON=
POY_LINK_GALAXY=
POY_SITE_URL=https://thepiratesofybor.com

# ───────── SECRET: Supabase Edge Function secrets only ─────────
# supabase secrets set ANTHROPIC_API_KEY=... (Claude API key from console.anthropic.com; powers the Quartermaster and the nightly questions)
ANTHROPIC_API_KEY=
# Any long random string. Must match the 'cron_secret' you store in Supabase Vault for the nightly job.
CRON_SECRET=
# Any long random string. Paste the same value as the Authorization header in RevenueCat's webhook settings.
REVENUECAT_WEBHOOK_AUTH=
# Optional: RevenueCat SECRET API key (sk_...), lets Delete My Account also erase the player in RevenueCat.
REVENUECAT_SECRET_KEY=
# Optional tuning
QUARTERMASTER_MODEL=claude-haiku-5-5
QUARTERMASTER_DAILY_LIMIT=40
QUESTION_WRITER_MODEL=claude-sonnet-5-5
QUESTION_CHECKER_MODEL=claude-sonnet-5-5
QUESTIONS_PER_CATEGORY=10
CATEGORIES_PER_RUN=4
# Only if you add more web addresses that call the functions
ALLOWED_ORIGINS=https://thepiratesofybor.com,https://www.thepiratesofybor.com,https://app.thepiratesofybor.com,capacitor://app.thepiratesofybor.com

# ───────── SECRET: Supabase Auth provider settings (Dashboard → Authentication → Providers) ─────────
# Used by `supabase` CLI config.toml when you manage auth from the repo; otherwise just type them in the dashboard.
SUPABASE_AUTH_APPLE_CLIENT_ID=com.raconsulting.piratesofybor.signin,com.raconsulting.piratesofybor
SUPABASE_AUTH_APPLE_SECRET=
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_FACEBOOK_SECRET=
