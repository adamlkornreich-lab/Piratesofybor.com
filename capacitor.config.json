{
  "appId": "com.raconsulting.piratesofybor",
  "appName": "Pirates of Ybor",
  "webDir": "www",
  "backgroundColor": "#0b1a26",
  "server": {
    "androidScheme": "https",
    "iosScheme": "capacitor",
    "hostname": "app.thepiratesofybor.com"
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "launchAutoHide": true,
      "backgroundColor": "#0b1a26",
      "showSpinner": false
    }
  }
}
